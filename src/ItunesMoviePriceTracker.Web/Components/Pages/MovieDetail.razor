@page "/movie/{id:long}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IMovieService MovieService
@inject NavigationManager NavigationManager
@inject ILogger<MovieDetail> Logger

<PageTitle>@movie?.TrackName</PageTitle>

<div class="container mt-4">
    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else if (!string.IsNullOrEmpty(errorMessage) && movie is null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (movie is null)
    {
        <div class="alert alert-warning">Movie not found.</div>
    }
    else
    {
        <h3 class="text-center mb-4">@movie.TrackName</h3>

        <div class="row mb-4">
            <div class="col-md-2">
                <img src="@movie.ArtworkUrl400" class="img-fluid rounded" alt="@movie.TrackName" />
            </div>
            <div class="col-md-4">
                <p><strong>Director:</strong> @movie.ArtistName</p>
                <p><strong>Release:</strong> @movie.ReleaseDate?.ToString("yyyy")</p>
                <p><strong>Current Price:</strong> @movie.TrackHdPrice</p>
                <div class="input-group mb-2" style="max-width: 260px;">
                    <span class="input-group-text">Watch Price</span>
                    <input type="number" class="form-control" @bind="watchPrice" placeholder="e.g. 39" />
                    <button class="btn btn-primary" type="button" @onclick="SaveWatchPriceAsync">Save</button>
                </div>
                @if (!string.IsNullOrEmpty(watchPriceMessage))
                {
                    <small class="text-success">@watchPriceMessage</small>
                }
                <p class="mt-2"><small>@movie.LongDescription</small></p>
            </div>
        </div>

        <div class="mb-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => showChart = !showChart">
                @(showChart ? "📋 List" : "📈 Chart")
            </button>
        </div>

        @if (showChart)
        {
            <RadzenChart Style="height: 300px; background: transparent;">
                <RadzenChartTooltipOptions Visible="true" />
                <RadzenLineSeries Interpolation="Interpolation.Step"
                                  Data="@priceItems"
                                  CategoryProperty="Date"
                                  Title="Price"
                                  ValueProperty="Price"
                                  Stroke="#4CAF50"
                                  StrokeWidth="2">
                    <TooltipTemplate Context="data">
                        <div>
                            <strong>@((data as PriceDynamic)?.Date.ToString("yyyy-MM-dd"))</strong>
                            @if (!string.IsNullOrEmpty(data.Trend))
                            {
                                <img style="height: 20px; margin-left: 4px;" src="@data.Trend" alt="trend" />
                            }
                            <br />Price: @((data as PriceDynamic)?.Price.ToString("N2"))
                        </div>
                    </TooltipTemplate>
                    <ChildContent>
                        <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
                        <RadzenSeriesDataLabels Visible="true" />
                    </ChildContent>
                </RadzenLineSeries>
                <RadzenCategoryAxis FormatString="{0:yyyy-MM-dd}" />
                <RadzenValueAxis FormatString="{0:N2}" />
            </RadzenChart>
        }
        else
        {
            <div class="col-md-6">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Trend</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pagedItems)
                        {
                            <tr>
                                <td>@item.Date.ToShortDateString()</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Trend))
                                    {
                                        <img style="height: 20px" src="@item.Trend" alt="trend" />
                                    }
                                </td>
                                <td>@item.Price</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (totalPages > 1)
                {
                    <nav>
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => currentPage--">«</button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                    <button class="page-link" @onclick="() => currentPage = pageNumber">@pageNumber</button>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => currentPage++">»</button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    }

    <div class="mt-3">
        <button class="btn btn-secondary me-2" @onclick="BackToList">Back to list</button>
        <button class="btn btn-danger" @onclick="ShowDeleteModal" disabled="@(movie is null)">Delete</button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }

    @if (showDeleteModal)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Movie</h5>
                        <button type="button" class="btn-close" @onclick="HideDeleteModal" disabled="@isDeleting"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete <strong>@movie?.TrackName</strong>?
                        This will also delete all price history for this movie.
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="HideDeleteModal" disabled="@isDeleting">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="DeleteMovieAsync" disabled="@isDeleting">
                            @(isDeleting ? "Deleting..." : "Delete")
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
</div>

@code {
    [Parameter]
    public long id { get; set; }

    private MovieDto? movie;
    private List<PriceDynamic> priceItems = new();
    private decimal? watchPrice;
    private string watchPriceMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = true;
    private bool showChart = true;
    private bool showDeleteModal;
    private bool isDeleting;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling(priceItems.Count / (double)pageSize);
    private List<PriceDynamic> pagedItems => priceItems
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            movie = await MovieService.GetMovieWithPricesAsync(id);
            if (movie is not null)
            {
                watchPrice = movie.WatchPrice;
                CalcPriceTrend();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load movie {TrackId}", id);
            errorMessage = "Could not load the movie.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveWatchPriceAsync()
    {
        if (watchPrice is < 0)
        {
            errorMessage = "Watch price cannot be negative.";
            return;
        }

        try
        {
            await MovieService.UpdateWatchPriceAsync(id, watchPrice);
            watchPriceMessage = "Watch price saved.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save watch price for movie {TrackId}", id);
            errorMessage = "Could not save the watch price.";
        }
    }

    private void ShowDeleteModal()
    {
        errorMessage = string.Empty;
        showDeleteModal = true;
    }

    private void HideDeleteModal() => showDeleteModal = false;

    private async Task DeleteMovieAsync()
    {
        isDeleting = true;
        try
        {
            var deleted = await MovieService.DeleteMovieAsync(id);
            if (deleted)
                BackToList();
            else
                errorMessage = "The movie could not be deleted.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete movie {TrackId}", id);
            errorMessage = "An error occurred while deleting the movie.";
        }
        finally
        {
            isDeleting = false;
            showDeleteModal = false;
        }
    }

    private void BackToList() => NavigationManager.NavigateTo("/");

    private void CalcPriceTrend()
    {
        if (movie?.Prices is null || !movie.Prices.Any()) return;

        var sorted = movie.Prices.OrderByDescending(p => p.Date).ToList();
        priceItems = sorted.Select(p => new PriceDynamic { Date = p.Date, Price = p.Price }).ToList();

        var allTimeLow = priceItems.Min(p => p.Price);

        for (int i = 0; i < priceItems.Count - 1; i++)
        {
            if (priceItems[i].Price == allTimeLow)
                priceItems[i].Trend = "images/arrow_yellow.png";
            else if (priceItems[i].Price > priceItems[i + 1].Price)
                priceItems[i].Trend = "images/arrow_red.png";
            else if (priceItems[i].Price < priceItems[i + 1].Price)
                priceItems[i].Trend = "images/arrow_green.png";
        }
    }

    private class PriceDynamic
    {
        public DateTime Date { get; set; }
        public decimal Price { get; set; }
        public string Trend { get; set; } = string.Empty;
    }
}
