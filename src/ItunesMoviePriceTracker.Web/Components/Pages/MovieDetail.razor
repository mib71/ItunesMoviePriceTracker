@page "/movie/{id:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IJSRuntime JS
@inject IMovieService MovieService
@inject IMoviePriceService MoviePriceService
@inject NavigationManager NavigationManager

<PageTitle>@movie?.TrackName</PageTitle>

<div class="container mt-4">
    @if (movie is not null)
    {
        <h3 class="text-center mb-4">@movie.TrackName</h3>

        <div class="row mb-4">
            <div class="col-md-2">
                <img src="@movie.ArtworkUrl400" class="img-fluid rounded" alt="@movie.TrackName" />
            </div>
            <div class="col-md-4">
                <p><strong>Director:</strong> @movie.ArtistName</p>
                <p><strong>Release:</strong> @movie.ReleaseDate?.ToString("yyyy")</p>
                <p><strong>Current Price:</strong> @movie.TrackHdPrice</p>
                <div class="input-group mb-2" style="max-width: 250px;">
                    <span class="input-group-text">Watch Price</span>
                    <input type="number" class="form-control" @bind="watchPrice" placeholder="e.g. 39" />
                    <button class="btn btn-primary" type="button" @onclick="SaveWatchPrice">Save</button>
                </div>
                @if (!string.IsNullOrEmpty(watchPriceMessage))
                {
                    <small class="text-success">@watchPriceMessage</small>
                }
                <p class="mt-2"><small>@movie.LongDescription</small></p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Trend</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in priceItems)
                        {
                            <tr>
                                <td>@item.Date.ToShortDateString()</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Trend))
                                    {
                                        <img style="height: 20px" src="@item.Trend" alt="trend" />
                                    }
                                </td>
                                <td>@item.Price</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="mt-3">
        <button class="btn btn-secondary me-2" @onclick="BackToList">Back to list</button>
        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete</button>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Movie</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete <strong>@movie?.TrackName</strong>?
                    This will also delete all price history for this movie.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteMovie">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    private MovieDto? movie;
    private List<PriceDynamic> priceItems = new();
    private decimal? watchPrice;
    private string watchPriceMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        movie = await MovieService.GetMovieWithPricesAsync(id);
        if (movie is not null)
        {
            watchPrice = movie.WatchPrice;
            CalcPriceTrend();
        }
    }    

    private async Task SaveWatchPrice()
    {
        await MovieService.UpdateWatchPriceAsync(id, watchPrice);
        watchPriceMessage = "Watch price saved!";
    }

    private async Task DeleteMovie()
    {
        var result = await MovieService.DeleteMovieAsync(id);
        if (result) BackToList();
    }

    private void BackToList() => NavigationManager.NavigateTo("/");

    private void CalcPriceTrend()
    {
        if (movie?.Prices is null) return;

        var sorted = movie.Prices.OrderByDescending(p => p.Date).ToList();
        priceItems = sorted.Select(p => new PriceDynamic { Date = p.Date, Price = p.Price }).ToList();

        var allTimeLow = priceItems.Min(p => p.Price);

        for (int i = 0; i < priceItems.Count - 1; i++)
        {
            if (priceItems[i].Price == allTimeLow)
                priceItems[i].Trend = "images/arrow_yellow.png";
            else if (priceItems[i].Price > priceItems[i + 1].Price)
                priceItems[i].Trend = "images/arrow_red.png";
            else if (priceItems[i].Price < priceItems[i + 1].Price)
                priceItems[i].Trend = "images/arrow_green.png";
        }
    }

    private class PriceDynamic
    {
        public DateTime Date { get; set; }
        public decimal Price { get; set; }
        public string Trend { get; set; } = string.Empty;
    }
}