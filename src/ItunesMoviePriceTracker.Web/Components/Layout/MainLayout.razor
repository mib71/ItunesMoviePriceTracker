@inherits LayoutComponentBase
@inject IStoreSettingsProvider StoreSettingsProvider
@inject NavigationManager NavigationManager
<RadzenComponents @rendermode="InteractiveServer" />

<div class="container py-2 d-flex justify-content-between align-items-center">
    <span class="fw-bold fs-5">🎬 Itunes Movie Price Tracker</span>
    <button class="btn btn-sm btn-outline-secondary" id="theme-toggle">
        🌙 Dark
    </button>
</div>

<hr class="mt-0 mb-0" />

<main>
    <article class="container-fluid px-4 py-3">
        @Body
    </article>
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Pages that must render even when no store has been selected.
    private static readonly string[] PathsWithoutStoreCheck = ["setup", "error"];

    protected override async Task OnInitializedAsync()
    {
        if (IsPathWithoutStoreCheck())
            return;

        if (await StoreSettingsProvider.GetAsync() is null)
            NavigationManager.NavigateTo("/setup");
    }

    private bool IsPathWithoutStoreCheck()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];
        return PathsWithoutStoreCheck.Contains(path, StringComparer.OrdinalIgnoreCase);
    }
}